FROM registry.access.redhat.com/ubi9/go-toolset:1.24.6-1762373805 as builder
WORKDIR /app

# Switch to root for build operations
USER 0

COPY . .
# Copy dependencies first (most stable)
#COPY go.* ./
#COPY go.mod go.sum ./

# Download dependencies (cached layer)
#RUN --mount=type=cache,target=/opt/app-root/src/go/pkg/mod \
#    go mod download

# Copy build tools and configs
COPY Makefile .

# Copy source code directories
COPY ./api ./api
COPY ./cmd ./cmd
COPY ./deploy ./deploy
COPY ./hack ./hack
COPY ./internal ./internal
COPY ./pkg ./pkg
COPY ./test ./test
COPY ./packaging/containers/cli-artifacts/nginx.conf ./packaging/containers/cli-artifacts/nginx.conf
COPY ./packaging/containers/cli-artifacts/entrypoint.sh ./packaging/containers/cli-artifacts/entrypoint.sh

RUN rm -f /etc/yum.repos.d/*
COPY centos.repo /etc/yum.repos.d/centos.repo
#RUN sed -i '/\[baseos\]/a baseurl=https://mirror.stream.centos.org/9-stream/BaseOS/x86_64/os/' /etc/yum.repos.d/centos.repo && \
#    sed -i '/\[appstream\]/a baseurl=https://mirror.stream.centos.org/9-stream/AppStream/x86_64/os/' /etc/yum.repos.d/centos.repo && \
#    # Change gpgcheck to 0 for baseos as requested
#    sed -i '/\[baseos\]/,/\[/ s/gpgcheck=1/gpgcheck=0/' /etc/yum.repos.d/centos.repo

RUN sed -i '/\[baseos\]/a baseurl=https://mirror.stream.centos.org/9-stream/BaseOS/x86_64/os/' /etc/yum.repos.d/centos.repo && \
    sed -i '/\[appstream\]/a baseurl=https://mirror.stream.centos.org/9-stream/AppStream/x86_64/os/' /etc/yum.repos.d/centos.repo && \
    # Download the actual CentOS official key
    curl -Lo /etc/pki/rpm-gpg/RPM-GPG-KEY-centosofficial https://www.centos.org/keys/RPM-GPG-KEY-CentOS-Official && \
    # Ensure the repo file points to this local key path
    sed -i 's|gpgkey=.*|gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-centosofficial|' /etc/yum.repos.d/centos.repo && \
    # Enable GPG check for security (now that we have the key)
    sed -i 's/gpgcheck=0/gpgcheck=1/' /etc/yum.repos.d/centos.repo

COPY fedora-pubkey.gpg fedora-pubkey.gpg
RUN rpm --import fedora-pubkey.gpg
## Clear cache to force use of new URLs
#RUN microdnf clean all && microdnf makecache


# Use BuildKit cache mounts for dnf package caching
RUN --mount=type=cache,target=/var/cache/dnf \
    --mount=type=cache,target=/var/lib/dnf \
    dnf install --nodocs -y jq

# Define version info ARGs right before build
ARG SOURCE_GIT_TAG
ARG SOURCE_GIT_TREE_STATE
ARG SOURCE_GIT_COMMIT

# Convert ARGs to ENV so make can use them
ENV SOURCE_GIT_TAG=${SOURCE_GIT_TAG}
ENV SOURCE_GIT_TREE_STATE=${SOURCE_GIT_TREE_STATE}
ENV SOURCE_GIT_COMMIT=${SOURCE_GIT_COMMIT}

# Use BuildKit cache mounts for Go caching
RUN --mount=type=cache,target=/opt/app-root/src/.cache/go-build \
    make build-multiarch-clis
#    --mount=type=cache,target=/opt/app-root/src/go/pkg/mod \

FROM registry.access.redhat.com/ubi9/ubi-minimal:9.7-1763362218

RUN rm -f /etc/yum.repos.d/*
COPY centos.repo /etc/yum.repos.d/centos.repo
#RUN sed -i '/\[baseos\]/a baseurl=https://mirror.stream.centos.org/9-stream/BaseOS/x86_64/os/' /etc/yum.repos.d/centos.repo && \
#    sed -i '/\[appstream\]/a baseurl=https://mirror.stream.centos.org/9-stream/AppStream/x86_64/os/' /etc/yum.repos.d/centos.repo && \
#    # Change gpgcheck to 0 for baseos as requested
#    sed -i '/\[baseos\]/,/\[/ s/gpgcheck=1/gpgcheck=0/' /etc/yum.repos.d/centos.repo

RUN sed -i '/\[baseos\]/a baseurl=https://mirror.stream.centos.org/9-stream/BaseOS/x86_64/os/' /etc/yum.repos.d/centos.repo && \
    sed -i '/\[appstream\]/a baseurl=https://mirror.stream.centos.org/9-stream/AppStream/x86_64/os/' /etc/yum.repos.d/centos.repo && \
    # Download the actual CentOS official key
    curl -Lo /etc/pki/rpm-gpg/RPM-GPG-KEY-centosofficial https://www.centos.org/keys/RPM-GPG-KEY-CentOS-Official && \
    # Ensure the repo file points to this local key path
    sed -i 's|gpgkey=.*|gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-centosofficial|' /etc/yum.repos.d/centos.repo && \
    # Enable GPG check for security (now that we have the key)
    sed -i 's/gpgcheck=0/gpgcheck=1/' /etc/yum.repos.d/centos.repo

COPY fedora-pubkey.gpg fedora-pubkey.gpg
RUN rpm --import fedora-pubkey.gpg
## Clear cache to force use of new URLs
#RUN microdnf clean all && microdnf makecache

# Use BuildKit cache mounts for dnf package caching
RUN --mount=type=cache,target=/var/cache/dnf \
    --mount=type=cache,target=/var/lib/dnf \
    microdnf install --nodocs --setopt install_weak_deps=0 -y nginx && \
    rm -f /etc/nginx/nginx.conf /etc/nginx/conf.d/default.conf

ENV USER_UID=1001 \
    USER_NAME=server \
    HOME=/home/server \
    NGINX_CONF_PATH=/etc/nginx/nginx.conf

COPY --from=builder /app/packaging/containers/cli-artifacts/nginx.conf ${NGINX_CONF_PATH}
COPY --chmod=0755 --from=builder /app/packaging/containers/cli-artifacts/entrypoint.sh /usr/local/bin/entrypoint.sh

USER root

RUN mkdir -p ${HOME}/src/gh-archives && \
    chown ${USER_UID}:0 ${HOME} && \
    chmod 755 ${HOME} && \
    sed '/^\s*listen\s*\[::\]:8090/d' ${NGINX_CONF_PATH} > ${NGINX_CONF_PATH}.ipv4 && \
    sed '/^\s*listen\s*8090/d' ${NGINX_CONF_PATH} > ${NGINX_CONF_PATH}.ipv6 && \
    chmod 755 ${NGINX_CONF_PATH} ${NGINX_CONF_PATH}.ipv* && \
    chmod -R 775 /var/lib/nginx && \
    chown -R ${USER_UID}:0 /root && \
    chown -R ${USER_UID}:0 /var/lib/nginx && \
    chmod -R 775 /var/log/nginx && \
    chown -R ${USER_UID}:0 /var/log/nginx && \
    chmod -R 775 /var/run && \
    chown -R ${USER_UID}:0 /var/run

COPY --chown=${USER_UID}:0 --chmod=0755 --from=builder /app/bin/clis/gh-archives/ ${HOME}/src/gh-archives/
RUN chmod 666 ${HOME}/src/gh-archives/index.json

USER ${USER_UID}
WORKDIR ${HOME}/src

LABEL \
  com.redhat.component="flightctl-cli-artifacts-container" \
  description="Container image exposing multi-arch Flight Control CLI binaries over HTTP" \
  io.k8s.description="Container image exposing multi-arch Flight Control CLI binaries over HTTP" \
  io.k8s.display-name="Flight Control CLI multiarch artifacts with server" \
  io.openshift.tags="flightctl,cli-artifacts" \
  name="flightctl-cli-artifacts" \
  summary="Container image exposing multi-arch Flight Control CLI binaries over HTTP"
EXPOSE 8090

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
