FROM registry.access.redhat.com/ubi9/go-toolset:1.24.6-1762373805 as build
WORKDIR /app
ARG SOURCE_GIT_TAG
ARG SOURCE_GIT_TREE_STATE
ARG SOURCE_GIT_COMMIT

# Switch to root for build operations
USER 0

COPY . .
# Copy dependencies first (most stable)
#COPY go.* ./
#COPY go.mod go.sum ./

# Download dependencies (cached layer)
#RUN --mount=type=cache,target=/opt/app-root/src/go/pkg/mod \
#    go mod download

# Copy build tools and configs
COPY Makefile .

# Copy source code directories
COPY ./api ./api
COPY ./cmd ./cmd
COPY ./deploy ./deploy
COPY ./hack ./hack
COPY ./internal ./internal
COPY ./pkg ./pkg
COPY ./test ./test

# Convert ARGs to ENV so make can use them
ENV SOURCE_GIT_TAG=${SOURCE_GIT_TAG}
ENV SOURCE_GIT_TREE_STATE=${SOURCE_GIT_TREE_STATE}
ENV SOURCE_GIT_COMMIT=${SOURCE_GIT_COMMIT}

# Use BuildKit cache mounts for Go caching
RUN --mount=type=cache,target=/opt/app-root/src/.cache/go-build \
    make build-db-migrate
#    --mount=type=cache,target=/opt/app-root/src/go/pkg/mod \

FROM registry.access.redhat.com/ubi9/ubi-minimal:9.7-1763362218

WORKDIR /app

LABEL \
  com.redhat.component="flightctl-db-setup-container" \
  description="Flight Control Database Setup Tools" \
  io.k8s.description="Flight Control Database Setup Tools" \
  io.k8s.display-name="Flight Control Database Setup" \
  io.openshift.tags="flightctl,db-setup" \
  name="flightctl-db-setup" \
  summary="Flight Control Database Setup Tools"

# Install required tools for database operations
# Use BuildKit cache mounts for microdnf package caching
#RUN --mount=type=cache,target=/var/cache/dnf \
#    --mount=type=cache,target=/var/lib/dnf \

RUN rm -f /etc/yum.repos.d/*
COPY centos.repo /etc/yum.repos.d/centos.repo
#RUN sed -i '/\[baseos\]/a baseurl=https://mirror.stream.centos.org/9-stream/BaseOS/x86_64/os/' /etc/yum.repos.d/centos.repo && \
#    sed -i '/\[appstream\]/a baseurl=https://mirror.stream.centos.org/9-stream/AppStream/x86_64/os/' /etc/yum.repos.d/centos.repo && \
#    # Change gpgcheck to 0 for baseos as requested
#    sed -i '/\[baseos\]/,/\[/ s/gpgcheck=1/gpgcheck=0/' /etc/yum.repos.d/centos.repo

RUN sed -i '/\[baseos\]/a baseurl=https://mirror.stream.centos.org/9-stream/BaseOS/x86_64/os/' /etc/yum.repos.d/centos.repo && \
    sed -i '/\[appstream\]/a baseurl=https://mirror.stream.centos.org/9-stream/AppStream/x86_64/os/' /etc/yum.repos.d/centos.repo && \
    # Download the actual CentOS official key
    curl -Lo /etc/pki/rpm-gpg/RPM-GPG-KEY-centosofficial https://www.centos.org/keys/RPM-GPG-KEY-CentOS-Official && \
    # Ensure the repo file points to this local key path
    sed -i 's|gpgkey=.*|gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-centosofficial|' /etc/yum.repos.d/centos.repo && \
    # Enable GPG check for security (now that we have the key)
    sed -i 's/gpgcheck=0/gpgcheck=1/' /etc/yum.repos.d/centos.repo

COPY fedora-pubkey.gpg fedora-pubkey.gpg
RUN rpm --import fedora-pubkey.gpg
## Clear cache to force use of new URLs
#RUN microdnf clean all && microdnf makecache
RUN microdnf install --nodocs --setopt install_weak_deps=0 -y postgresql gettext python3-pyyaml

# Copy the migration binary from the build stage
COPY --from=build /app/bin/flightctl-db-migrate /usr/local/bin/flightctl-db-migrate

# Copy the database setup scripts
COPY --chmod=0755 ./deploy/scripts/setup_database_users.sh \
                  ./deploy/scripts/migration-setup.sh \
                  ./deploy/scripts/wait-for-database.sh \
                  ./deploy/scripts/yaml_helpers.py \
                  ./deploy/scripts/
COPY ./deploy/scripts/setup_database_users.sql ./deploy/scripts/setup_database_users.sql

CMD ["./deploy/scripts/setup_database_users.sh"]
